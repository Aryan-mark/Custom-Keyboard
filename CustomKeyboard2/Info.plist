<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>CustomKeyboard2</string> <!-- The display name for your keyboard -->
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string> <!-- Your custom keyboard's unique identifier -->
    <key>CFBundleVersion</key>
    <string>1.0</string> <!-- Version of your keyboard extension -->
    
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionAttributes</key>
        <dict>
            <key>IsASCIICapable</key>
            <false/> <!-- Set this to true if your keyboard will only use ASCII characters -->
            <key>PrefersRightToLeft</key>
            <false/> <!-- Set this to true if your keyboard is for right-to-left languages -->
            <key>PrimaryLanguage</key>
            <string>en-US</string> <!-- You can change this to 'hi' for Hindi or any other language -->
            <key>RequestsOpenAccess</key>
            <false/> <!-- Set this to true if you require open access to the device (for advanced functionality) -->
        </dict>
        
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.keyboard-service</string> <!-- Identifies the keyboard service -->
        
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).KeyboardViewController</string> <!-- Specifies your keyboard's view controller class -->
    </dict>
    
    <!-- Additional optional settings if necessary -->
    <key>UIInputViewControllerClass</key>
    <string>KeyboardViewController</string> <!-- Optional: define the input view controller class explicitly -->
    
</dict>
</plist>
